# Copy to .env and fill in. NEVER commit .env.

# --- Brain (you already have this) ---
ANTHROPIC_API_KEY=

# --- Ears: Deepgram STT ---
DEEPGRAM_API_KEY=

# --- Voice: Cartesia TTS ---
CARTESIA_API_KEY=
# After you clone the brand voice, put its id here (falls back to a preset if empty).
CARTESIA_VOICE_ID=

# --- Orchestrator: LiveKit ---
# From your LiveKit Cloud project (Settings -> Keys). Needed only when running
# as a worker (dev/start); NOT needed for `console` local mic testing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Model choices (override if you want) ---
LLM_MODEL=claude-haiku-4-5-20251001
STT_MODEL=nova-3
